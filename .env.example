# ============================================================
# StudyForge AI — 環境変数サンプル
# このファイルをコピーして .env.local を作成してください
#   cp .env.example .env.local
# ============================================================

# ------------------------------------------------------------
# Supabase
# Supabase ダッシュボード > Settings > API から取得
# https://app.supabase.com/project/<your-project>/settings/api
# ------------------------------------------------------------

# プロジェクトURL（例: https://xxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# anon/public キー（フロントエンドから使用するため NEXT_PUBLIC_ プレフィックス必須）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# Anthropic Claude API
# https://console.anthropic.com/settings/keys から取得
# ⚠️ このキーはサーバーサイドのみで使用し、フロントエンドに露出させないこと
# ------------------------------------------------------------

ANTHROPIC_API_KEY=
